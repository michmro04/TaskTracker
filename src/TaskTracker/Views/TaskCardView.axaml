<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskTracker.ViewModels"
             xmlns:sys="using:System"
             x:Class="TaskTracker.Views.TaskCardView"
             x:DataType="vm:TaskCardViewModel">

	<UserControl.Styles>
		<!-- zadanie wykonane (archiwum): przygaszony kafelek i przekreślony tytuł -->
		<Style Selector="Border.card.done">
			<Setter Property="Opacity" Value="0.75"/>
		</Style>
		<Style Selector="TextBlock.title.done">
			<Setter Property="TextDecorations" Value="Strikethrough"/>
		</Style>
	</UserControl.Styles>

	<Border Classes="card"
            Classes.done="{Binding Item.Wykonane}"
            HorizontalAlignment="Stretch"
            Padding="14"
            CornerRadius="10"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1">

		<StackPanel Spacing="8">

			<Grid ColumnDefinitions="Auto,*,Auto">
				<CheckBox Grid.Column="0"
                          IsChecked="{Binding Item.Wykonane}"
                          ToolTip.Tip="Oznacz jako wykonane"
                          VerticalAlignment="Top"/>

				<TextBlock Grid.Column="1"
                           Classes="title"
                           Classes.done="{Binding Item.Wykonane}"
                           Text="{Binding Item.Tytul}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

				<Border Grid.Column="2"
                        Background="{Binding PriorityBrush}"
                        CornerRadius="10"
                        Padding="8,2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top">
					<TextBlock Text="{Binding PriorityText}" FontSize="12" Foreground="White"/>
				</Border>
			</Grid>

			<TextBlock Text="✓ Wykonane – odznacz, aby przywrócić do &quot;Do zrobienia&quot;"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#22C55E"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Item.Wykonane}"/>

			<TextBlock Text="{Binding DeadlineText}"
                       FontSize="13"
                       Opacity="0.8"
                       IsVisible="{Binding !IsOverdue}"/>
			<TextBlock Text="{Binding DeadlineText}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#EF4444"
                       IsVisible="{Binding IsOverdue}"/>

			<ItemsControl ItemsSource="{Binding Item.Tagi}" IsVisible="{Binding HasTags}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="sys:String">
						<Border Background="{DynamicResource AppButtonBrush}"
                                CornerRadius="8"
                                Padding="8,2"
                                Margin="0,0,6,6">
							<TextBlock Text="{Binding}" FontSize="12"/>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

            <!-- opis -->
            <Border IsVisible="{Binding HasDescription}"
                    Background="{DynamicResource AppHeaderBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,6">
                <Grid x:Name="DescriptionGrid" ColumnDefinitions="*,Auto" MinHeight="24">
                    <TextBlock x:Name="DescriptionPreviewText"
                               Grid.Column="0"
                               Text="{Binding DescriptionPreview}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Opacity="0.85"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsDescriptionExpanded}"/>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Item.Opis}"
                               TextWrapping="Wrap"
                               Opacity="0.9"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsDescriptionExpanded}"/>

                    <Button Grid.Column="1"
                            Content="{Binding DescriptionToggleIcon}"
                            Command="{Binding ToggleDescriptionCommand}"
                            IsVisible="{Binding CanExpandDescription}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Top"
                            ToolTip.Tip="Rozwiń / zwiń opis"/>
                </Grid>
            </Border>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        IsVisible="{Binding !IsConfirmingDelete}">
				<Button Content="Edytuj" Command="{Binding EditCommand}"/>
				<Button Content="Usuń" Command="{Binding AskDeleteCommand}"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        IsVisible="{Binding IsConfirmingDelete}">
				<TextBlock Text="Usunąć to zadanie?" VerticalAlignment="Center"/>
				<Button Content="Tak, usuń"
                        Background="#EF4444"
                        Foreground="White"
                        Command="{Binding ConfirmDeleteCommand}"/>
				<Button Content="Nie" Command="{Binding CancelDeleteCommand}"/>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>