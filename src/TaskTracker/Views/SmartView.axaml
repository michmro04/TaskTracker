<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskTracker.ViewModels"
             xmlns:sys="using:System"
             x:Class="TaskTracker.Views.SmartView"
             x:DataType="vm:SmartViewModel">

	<UserControl.Styles>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="12"/>
		</Style>
		<!-- tło osi czasu = cały dostępny czas danego dnia -->
		<Style Selector="Border.track">
			<Setter Property="Background" Value="{DynamicResource AppCardBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Opacity" Value="0.5"/>
		</Style>
		<Style Selector="Border.session">
			<Setter Property="Background" Value="{DynamicResource AppButtonBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="6,4"/>
			<Setter Property="Margin" Value="1,0"/>
			<Setter Property="ClipToBounds" Value="True"/>
		</Style>
		<!-- sesja zadania z terminem na ten dzień - akcent po lewej -->
		<Style Selector="Border.session.due">
			<Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
			<Setter Property="BorderThickness" Value="3,1,1,1"/>
		</Style>
		<!-- przerwa -->
		<Style Selector="Border.session.free">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Opacity" Value="0.5"/>
		</Style>
		<Style Selector="NumericUpDown">
			<Setter Property="FormatString" Value="0"/>
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- ustawienia -->
		<Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
			<StackPanel Spacing="8">
				<WrapPanel Orientation="Horizontal">
					<StackPanel Margin="0,0,24,0" Spacing="4">
						<TextBlock Text="Min. długość sesji (min)" FontSize="12" Opacity="0.7"/>
						<NumericUpDown Value="{Binding MinSessionMinutes}" Minimum="5" Maximum="240" Increment="5" Width="150"/>
					</StackPanel>
					<StackPanel Spacing="4">
						<TextBlock Text="Maks. długość sesji (min)" FontSize="12" Opacity="0.7"/>
						<NumericUpDown Value="{Binding MaxSessionMinutes}" Minimum="5" Maximum="240" Increment="5" Width="150"/>
					</StackPanel>
				</WrapPanel>
				<TextBlock Text="{Binding Summary}" Opacity="0.8"/>
			</StackPanel>
		</Border>

		<!-- ostrzeżenia: zadania, które się nie zmieszczą przed terminem -->
		<Border Grid.Row="1" Classes="card" Margin="0,0,0,12"
		        BorderBrush="{DynamicResource AppAccentBrush}"
		        IsVisible="{Binding HasWarnings}">
			<StackPanel Spacing="4">
				<TextBlock Text="Nie zdążysz przy obecnych ustawieniach:" FontWeight="SemiBold"/>
				<ItemsControl ItemsSource="{Binding Warnings}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="sys:String">
							<TextBlock Text="{Binding}" TextWrapping="Wrap"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>

		<!-- 5 dni: dzień po lewej, oś czasu z sesjami po prawej -->
		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding Days}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:DayPlanViewModel">
						<Grid ColumnDefinitions="210,*" Margin="0,0,0,8">

							<!-- dzień -->
							<Border Grid.Column="0" Classes="card" Margin="0,0,8,0">
								<StackPanel Spacing="4">
									<TextBlock Text="{Binding Header}" FontWeight="Bold" TextWrapping="Wrap"/>
									<TextBlock Text="Mam czasu (min)" FontSize="11" Opacity="0.7"/>
									<NumericUpDown Value="{Binding AvailableMinutes}" Minimum="0" Maximum="1440" Increment="15"/>
									<TextBlock Text="{Binding CapacityText}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
								</StackPanel>
							</Border>

							<!-- oś czasu -->
							<ScrollViewer Grid.Column="1"
							              HorizontalScrollBarVisibility="Auto"
							              VerticalScrollBarVisibility="Disabled"
							              VerticalAlignment="Center">
								<Panel HorizontalAlignment="Left" Height="76" Margin="0,0,0,6">
									<Border Classes="track" Width="{Binding TrackWidth}" HorizontalAlignment="Left"/>
									<ItemsControl ItemsSource="{Binding Sessions}" Margin="0,4">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:SessionRow">
												<!-- zewnętrzny kontener trzyma dokładną szerokość = długość sesji -->
												<Panel Width="{Binding Width}" ToolTip.Tip="{Binding ToolTip}">
													<Border Classes="session"
													        Classes.free="{Binding IsFree}"
													        Classes.due="{Binding IsDueToday}">
														<StackPanel Spacing="1">
															<TextBlock Text="{Binding TimeText}" FontSize="10" Opacity="0.6"
															           TextTrimming="CharacterEllipsis"/>
															<TextBlock Text="{Binding Title}" FontWeight="SemiBold"
															           TextTrimming="CharacterEllipsis"/>
															<TextBlock Text="{Binding Details}" FontSize="11" Opacity="0.7"
															           TextTrimming="CharacterEllipsis"/>
														</StackPanel>
													</Border>
												</Panel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Panel>
							</ScrollViewer>
						</Grid>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</Grid>
</UserControl>
