<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TaskTracker.ViewModels"
             x:Class="TaskTracker.Views.AllTasksView"
             x:DataType="vm:AllTasksViewModel">
	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
		<TextBlock Text="Wszystkie zadania i archiwum" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
		<TextBlock Text="Filtrowanie, sortowanie, tagi" Opacity="0.7" HorizontalAlignment="Center"/>
		<TextBlock Text="{Binding Tasks.Count, StringFormat='Liczba zadań w pamięci: {0}'}" HorizontalAlignment="Center"/>
	</StackPanel>
</UserControl>