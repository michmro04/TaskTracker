<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaskTracker.ViewModels"
        x:Class="TaskTracker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TaskTracker"
        Width="1050"
        Height="700"
        MinWidth="800"
        MinHeight="550">

	<Grid RowDefinitions="Auto,*,Auto">
		<!-- górny pasek nawigacji i plików JSON -->
		<Border Grid.Row="0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#33888888">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<TextBlock Grid.Column="0"
                           Text="TaskTracker"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

				<!-- przełączanie 3 paneli -->
				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
					<Button Content="Smart"
                            Command="{Binding ShowSmartCommand}"
                            Classes.accent="{Binding IsSmartActive}"/>
					<Button Content="Do zrobienia"
                            Command="{Binding ShowDashboardCommand}"
                            Classes.accent="{Binding IsDashboardActive}"/>
					<Button Content="Wszystkie / Archiwum"
                            Command="{Binding ShowAllTasksCommand}"
                            Classes.accent="{Binding IsAllTasksActive}"/>
				</StackPanel>

				<!-- przyciski wczytywania i zapisu JSON -->
				<StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8">
					<Button Content="Wczytaj JSON" Click="OnLoadJsonClick"/>
					<Button Content="Zapisz JSON" Click="OnSaveJsonClick"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- aktywny panel z animacją przesuwania (slide) -->
		<TransitioningContentControl Grid.Row="1"
                                     Content="{Binding CurrentPage}"
                                     IsTransitionReversed="{Binding IsSlideReversed}"
                                     Padding="20">
			<TransitioningContentControl.PageTransition>
				<PageSlide Duration="0:0:0.25" Orientation="Horizontal"/>
			</TransitioningContentControl.PageTransition>
		</TransitioningContentControl>

		<!-- dolny pasek statusu -->
		<Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0" BorderBrush="#33888888">
			<TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.8"/>
		</Border>
	</Grid>
</Window>