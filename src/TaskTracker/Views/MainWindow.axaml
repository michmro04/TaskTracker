<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TaskTracker.ViewModels"
        xmlns:services="using:TaskTracker.Services"
        Background="{DynamicResource AppBackgroundBrush}"
        x:Class="TaskTracker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1050"
        Height="700"
        MinWidth="800"
        MinHeight="550">

	<Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="16,12" Background="{DynamicResource AppHeaderBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppBorderBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <TextBlock Text="TaskTracker"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Content="Plik ▾">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Nowy" Click="OnNewClick"/>
                                <MenuItem Header="Wczytaj..." Click="OnLoadClick"/>
                                <Separator/>
                                <MenuItem Header="Zapisz" Click="OnSaveClick"/>
                                <MenuItem Header="Zapisz jako..." Click="OnSaveAsClick"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

				<!-- przełączanie 3 paneli -->
				<StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
					<Button Content="Smart"
                            Command="{Binding ShowSmartCommand}"
                            Classes.accent="{Binding IsSmartActive}"/>
					<Button Content="Do zrobienia"
                            Command="{Binding ShowDashboardCommand}"
                            Classes.accent="{Binding IsDashboardActive}"/>
					<Button Content="Wszystkie / Archiwum"
                            Command="{Binding ShowAllTasksCommand}"
                            Classes.accent="{Binding IsAllTasksActive}"/>
				</StackPanel>

				<!-- przyciski wczytywania i zapisu JSON -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <ComboBox ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding SelectedAccent}"
                              Width="135" ToolTip.Tip="Kolor akcentu">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="services:AccentOption">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="6"
                                            Background="{Binding Brush}"
                                            BorderBrush="{DynamicResource AppBorderBrush}"
                                            BorderThickness="1"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="{Binding ThemeButtonLabel}"
                            Command="{Binding ToggleThemeCommand}"/>

                </StackPanel>
			</Grid>
		</Border>

		<!-- aktywny panel z animacją przesuwania (slide) -->
		<TransitioningContentControl Grid.Row="1"
                                     Content="{Binding CurrentPage}"
                                     IsTransitionReversed="{Binding IsSlideReversed}"
                                     Padding="20">
			<TransitioningContentControl.PageTransition>
				<PageSlide Duration="0:0:0.25" Orientation="Horizontal"/>
			</TransitioningContentControl.PageTransition>
		</TransitioningContentControl>

		<!-- dolny pasek statusu -->
        <Border Grid.Row="2" Padding="16,8" Background="{DynamicResource AppHeaderBrush}" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource AppBorderBrush}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Opacity="0.8"/>
		</Border>
	</Grid>
</Window>